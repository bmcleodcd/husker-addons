<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="script.controller.batteries" name="Controller batteries" version="1.0.1" provider-name="Husker">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">PS3 controller batteries and low-battery alerts</summary>
      <description lang="en_GB">Shows connected Sony controller batteries. Alerts at 25% and critically low, without repeated alerts after reconnecting.</description>
      <platform>linux</platform>
      <license>MIT</license>
    </extension>
  </addon>
  <addon id="script.husker.wifi" name="Wi-Fi manager" version="1.3.0" provider-name="Husker">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">View and change your Wi-Fi connection</summary>
      <description lang="en_GB">Network name, IP, signal and wireless link speed. Scan, connect and retry passwords. Requires the administrator-installed Husker Wi-Fi helper and Netplan/wpa_supplicant on Linux.</description>
      <platform>linux</platform>
      <license>MIT</license>
    </extension>
  </addon>
  <addon id="repository.husker" name="Husker's Add-ons" version="1.0.0" provider-name="Husker">
    <extension point="xbmc.addon.repository">
      <dir minversion="19.0.0">
        <info>https://bmcleodcd.github.io/husker-addons/addons.xml</info>
        <checksum>https://bmcleodcd.github.io/husker-addons/addons.xml.md5</checksum>
        <datadir>https://bmcleodcd.github.io/husker-addons/</datadir>
        <hashes>false</hashes>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Kodi utilities from Husker</summary>
      <description lang="en_GB">Husker's collection of Kodi add-ons.</description>
      <platform>all</platform>
      <license>MIT</license>
    </extension>
  </addon>
</addons>
